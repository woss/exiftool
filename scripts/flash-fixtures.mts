import { jpegWriter } from '../src/write/writers.js';
import { writeFileSync } from 'node:fs';

const values = [0x0, 0x1, 0x5, 0x7, 0x8, 0x9, 0xc, 0x10, 0x14, 0x18, 0x19, 0x1d, 0x20, 0x30, 0x41, 0x45, 0x47, 0x49, 0x4d, 0x4f, 0x50, 0x58, 0x59, 0x5d, 0x11];
for (const v of values) {
  const out = jpegWriter(new Uint8Array([0xff, 0xd8, 0xff, 0xd9]), { Flash: v });
  writeFileSync(`/tmp/flash-${v.toString(16)}.jpg`, out.bytes);
}
console.log('written', values.length);
