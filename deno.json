{
  "name": "exiftool-ts",
  "version": "0.1.0",
  "description": "ExifTool rewrite in TypeScript — read/write metadata across 140+ file formats",
  "license": "MIT",
  "tasks": {
    "cli": "deno run -A cli.ts",
    "test": "deno test -A",
    "generate-tags": "deno run -A scripts/generate-tags.ts",
    "test-harness": "deno run -A scripts/test-harness.ts",
    "check": "deno check mod.ts cli.ts src/**/*.ts"
  },
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli.ts"
  },
  "imports": {
    "exiftool-ts/": "./"
  },
  "lint": {
    "include": ["src/", "scripts/"],
    "exclude": ["src/tags/generated/"],
    "rules": {
      "exclude": ["no-unused-vars"]
    }
  },
  "fmt": {
    "include": ["src/", "scripts/"],
    "exclude": ["src/tags/generated/"],
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": true
  }
}
