{
  "name": "@woss/exiftool",
  "version": "0.1.1",
  "description": "ExifTool rewrite in TypeScript",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woss/exiftool.git"
  },
  "bin": {
    "exiftool-ts": "dist/cli.js"
  },
  "main": "dist/mod.js",
  "types": "dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/mod.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage-audit": "vitest run --coverage && tsx scripts/coverage-audit.ts",
    "build": "tsdown",
    "generate-tags": "tsx scripts/generate-tags.ts",
    "docs:api": "typedoc",
    "docs:api:html": "typedoc --options typedoc.html.json",
    "docs:build": "cd docs && pnpm build",
    "docs:dev": "cd docs && pnpm start",
    "docs:deploy": "cd docs && pnpm deploy"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-classic": "^3.10.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "publint": "^0.3.24",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}