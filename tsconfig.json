{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "mod.ts",
    "mod.test.ts",
    "debug.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".git",
    "dist"
  ]
}
